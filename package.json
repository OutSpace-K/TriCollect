{
  "name": "tricollect",
  "version": "0.1.26",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:audio": "node tests/audio-browser.mjs",
    "test:visual": "node tests/visual-qa.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "verify:seeds": "tsx scripts/verify-seeds.ts",
    "format": "prettier --write src tests scripts config *.json README.md docs",
    "format:check": "prettier --check src tests scripts config *.json README.md docs",
    "preview": "node scripts/serve.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "esbuild": "0.25.12",
    "tsx": "4.20.6",
    "prettier": "3.6.2",
    "playwright-core": "1.56.1",
    "@types/node": "24.10.0",
    "minigame-api-typings": "3.8.21"
  }
}
